{
  "name": "@bridgebyte/sst-vue",
  "version": "0.3.0",
  "description": "So Simple Table — Vue 3 adapter on top of @bridgebyte/sst-core.",
  "keywords": [
    "table",
    "data-table",
    "vue",
    "vue3",
    "composable",
    "reactive",
    "pagination",
    "sorting",
    "typescript",
    "so-simple-table"
  ],
  "homepage": "https://github.com/DinuIordachi/so-simple-table/tree/master/packages/vue#readme",
  "bugs": {
    "url": "https://github.com/DinuIordachi/so-simple-table/issues"
  },
  "license": "UNLICENSED",
  "author": "Dinu Iordachi <dimaiordachi3@gmail.com>",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/DinuIordachi/so-simple-table.git",
    "directory": "packages/vue"
  },
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./primevue": {
      "types": "./dist/primevue/index.d.ts",
      "import": "./dist/primevue.js",
      "require": "./dist/primevue.cjs"
    },
    "./style.css": "./dist/style.css",
    "./package.json": "./package.json"
  },
  "typesVersions": {
    "*": {
      "primevue": [
        "dist/primevue/index.d.ts"
      ]
    }
  },
  "files": [
    "dist",
    "README.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "sideEffects": [
    "**/*.css",
    "**/*.vue"
  ],
  "engines": {
    "node": ">=18.0.0"
  },
  "scripts": {
    "build": "vite build && vue-tsc --noEmit -p tsconfig.build.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "vue-tsc --noEmit -p tsconfig.json",
    "lint": "eslint src",
    "clean": "rimraf dist coverage"
  },
  "peerDependencies": {
    "@bridgebyte/sst-core": "^0.3.0",
    "primevue": "^4.5.0",
    "vue": "^3.5.0"
  },
  "peerDependenciesMeta": {
    "primevue": {
      "optional": true
    }
  },
  "devDependencies": {
    "@eslint/js": "^9.0.0",
    "@vitejs/plugin-vue": "^5.1.0",
    "@vue/test-utils": "^2.4.6",
    "eslint": "^9.0.0",
    "eslint-plugin-vue": "^9.28.0",
    "happy-dom": "^15.0.0",
    "typescript-eslint": "^8.0.0",
    "primevue": "^4.5.0",
    "vite": "^5.4.0",
    "vite-plugin-dts": "^4.0.0",
    "vitest": "^2.0.0",
    "vue": "^3.5.0",
    "vue-tsc": "^2.1.0"
  },
  "publishConfig": {
    "access": "public"
  }
}
